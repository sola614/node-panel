# 统一用 LF，避免 Windows 检出 CRLF 后把换行符带进 shell 脚本与 YAML
* text=auto eol=lf

*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
